+func TestSharedNamedResponsesNameCollisions(t *testing.T) {
+	t.Parallel()
+	defer discardOutput()()
+
+	spec := filepath.Join(sharedResponsesFixtures, "collisions.yaml")
+	shared := map[int][]string{
+		400:           {"GetThing", "PostThing"},
+		404:           {"GetThing", "ListThings"},
+		409:           {"PostThing", "ListThings"},
+		410:           {"ListThings", "DeleteThing"},
+		412:           {"ListThings", "DeleteThing"},
+		418:           {"GetThing", "PostThing"},
+		422:           {"GetThing", "ListThings"},
+		429:           {"GetThing", "ListThings"},
+		501:           {"GetThing", "PostThing"},
+		503:           {"GetThing", "PostThing"},
+		defaultStatus: {"ListThings", "DeleteThing"},
+	}
+	counts := map[int]int{
+		400: 1, 404: 1, 409: 1, 410: 1, 412: 1, 418: 1, 422: 1, 429: 1, 451: 2, 501: 1, 503: 1, defaultStatus: 1,
+	}
+
+	t.Run("client", func(t *testing.T) {
+		t.Parallel()
+
+		target := newSharedResponsesModule(t)
+		generateSharedResponsesClient(t, spec, target)
+
+		pkg := inspectGeneratedPackage(t, filepath.Join(target, "client", "operations"))
+		for code, operations := range shared {
+			pkg.assertShared(t, code, operations...)
+		}
+		busy := pkg.assertShared(t, 451, "DeleteThing", "PutThing")
+		otherBusy := pkg.assertShared(t, 451, "ListThings", "PatchThing")
+		assert.NotEqual(t, busy, otherBusy)
+		pkg.assertTypesByStatus(t, counts)
+
+		runGoInModule(t, target, "build", "./...")
+	})
+
+	for _, strict := range []bool{false, true} {
+		t.Run(fmt.Sprintf("server with strict responders: %t", strict), func(t *testing.T) {
+			t.Parallel()
+
+			target := newSharedResponsesModule(t)
+			generateSharedResponsesServer(t, spec, target, func(opts *GenOpts) {
+				opts.StrictResponders = strict
+			})
+
+			pkg := inspectGeneratedPackage(t, filepath.Join(target, "restapi", "operations"))
+			pkg.assertTypesByStatus(t, counts)
+
+			if strict {
+				// the responder of an operation accepts the shared types
+				for code, operations := range shared {
+					pkg.assertShared(t, code, operations...)
+				}
+			}
+
+			runGoInModule(t, target, "build", "./...")
+		})
+	}
+}
