+func readGeneratedSources(t *testing.T, dir string) map[string]string {
+	t.Helper()
+
+	entries, err := os.ReadDir(dir)
+	require.NoError(t, err)
+
+	sources := make(map[string]string, len(entries))
+	for _, entry := range entries {
+		content, err := os.ReadFile(filepath.Join(dir, entry.Name()))
+		require.NoError(t, err)
+		sources[entry.Name()] = string(content)
+	}
+
+	return sources
+}
+
+func runGoInModule(t *testing.T, dir string, args ...string) {
+	t.Helper()
+
+	const timeout = 5 * time.Minute
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+
+	cmd := exec.CommandContext(ctx, "go", args...)
+	cmd.Dir = dir
+	// Dependencies missing from the module are resolved from the module cache first:
+	// this builds without network whenever the dependencies of generated code are cached.
+	cmd.Env = append(os.Environ(), "GOFLAGS=-mod=mod", "GOWORK=off", "GOPROXY="+moduleCacheProxy(t))
+
+	output, err := cmd.CombinedOutput()
+	require.NoErrorf(t, err, "go %s failed in %s:\n%s", strings.Join(args, " "), dir, output)
+}
+
+// moduleCacheProxy uses the module cache as a module proxy, before the configured proxies.
+func moduleCacheProxy(t *testing.T) string {
+	t.Helper()
+
+	goEnv := func(name string) string {
+		output, err := exec.Command("go", "env", name).Output()
+		require.NoError(t, err)
+
+		return strings.TrimSpace(string(output))
+	}
+
+	cache := filepath.ToSlash(filepath.Join(goEnv("GOMODCACHE"), "cache", "download"))
+	if !strings.HasPrefix(cache, "/") {
+		cache = "/" + cache // e.g. file:///C:/...
+	}
+
+	proxy := "file://" + cache
+	if configured := goEnv("GOPROXY"); configured != "" && configured != "off" {
+		proxy += "," + configured
+	}
+
+	return proxy
+}
