+// generatedPackage describes the responses declared and used in a package of generated code.
+type generatedPackage struct {
+	dir     string
+	imports []string
+	// statuses holds the status code of each response type (-1 for a default response)
+	statuses map[string]int
+	// uses tells which response type an operation uses for each status code.
+	//
+	// For clients, this is found from the reader of the operation.
+	// For servers, this is found from the responder of the operation (with strict responders only).
+	uses map[string]map[int]string
+}
+
+func inspectGeneratedPackage(t *testing.T, dir string) *generatedPackage {
+	t.Helper()
+
+	entries, err := os.ReadDir(dir)
+	require.NoErrorf(t, err, "expected generated package in %s", dir)
+
+	pkg := &generatedPackage{
+		dir:      dir,
+		statuses: make(map[string]int),
+		uses:     make(map[string]map[int]string),
+	}
+
+	fset := token.NewFileSet()
+	var files []*ast.File
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".go") || strings.HasSuffix(entry.Name(), "_test.go") {
+			continue
+		}
+
+		file, err := parser.ParseFile(fset, filepath.Join(dir, entry.Name()), nil, parser.SkipObjectResolution)
+		require.NoError(t, err)
+		files = append(files, file)
+
+		for _, spec := range file.Imports {
+			imported, err := strconv.Unquote(spec.Path.Value)
+			require.NoError(t, err)
+			pkg.imports = append(pkg.imports, imported)
+		}
+	}
+
+	// find response types and their status code
+	for _, file := range files {
+		for _, decl := range file.Decls {
+			fn, ok := decl.(*ast.FuncDecl)
+			if !ok || fn.Recv == nil || fn.Body == nil {
+				continue
+			}
+
+			switch fn.Name.Name {
+			case "WriteResponse": // server
+				ast.Inspect(fn.Body, func(node ast.Node) bool {
+					call, ok := node.(*ast.CallExpr)
+					if !ok || len(call.Args) != 1 {
+						return true
+					}
+					if selector, ok := call.Fun.(*ast.SelectorExpr); ok && selector.Sel.Name == "WriteHeader" {
+						pkg.statuses[receiverType(fn)] = statusCode(call.Args[0])
+					}
+
+					return true
+				})
+			case "Code": // client
+				if len(fn.Type.Params.List) == 0 && len(fn.Body.List) == 1 {
+					if ret, ok := fn.Body.List[0].(*ast.ReturnStmt); ok && len(ret.Results) == 1 {
+						pkg.statuses[receiverType(fn)] = statusCode(ret.Results[0])
+					}
+				}
+			}
+		}
+	}
+
+	// find which response types are used by operations
+	for _, file := range files {
+		for _, decl := range file.Decls {
+			fn, ok := decl.(*ast.FuncDecl)
+			if !ok || fn.Recv == nil || fn.Body == nil {
+				continue
+			}
+
+			receiver := receiverType(fn)
+			switch {
+			case fn.Name.Name == "ReadResponse" && strings.HasSuffix(receiver, "Reader"):
+				pkg.collectReader(strings.TrimSuffix(receiver, "Reader"), fn.Body)
+			case strings.HasSuffix(fn.Name.Name, "Responder") && len(fn.Body.List) == 0:
+				code, isResponse := pkg.statuses[receiver]
+				if !isResponse {
+					continue
+				}
+				pkg.use(strings.TrimSuffix(fn.Name.Name, "Responder"), code, receiver)
+			}
+		}
+	}
+
+	return pkg
+}
+
+func (p *generatedPackage) collectReader(operation string, body *ast.BlockStmt) {
+	var cases []*ast.CaseClause
+	ast.Inspect(body, func(node ast.Node) bool {
+		if clause, ok := node.(*ast.CaseClause); ok {
+			cases = append(cases, clause)
+		}
+
+		return true
+	})
+
+	if len(cases) == 0 {
+		// only a default response
+		if constructed := constructedType(body.List); constructed != "" {
+			p.use(operation, defaultStatus, constructed)
+		}
+
+		return
+	}
+
+	for _, clause := range cases {
+		constructed := constructedType(clause.Body)
+		if constructed == "" {
+			continue
+		}
+
+		if len(clause.List) == 0 {
+			p.use(operation, defaultStatus, constructed)
+
+			continue
+		}
+
+		for _, expr := range clause.List {
+			p.use(operation, statusCode(expr), constructed)
+		}
+	}
+}
+
+func (p *generatedPackage) use(operation string, code int, typeName string) {
+	if p.uses[operation] == nil {
+		p.uses[operation] = make(map[int]string)
+	}
+	p.uses[operation][code] = typeName
+}
+
+// assertShared checks that the operations use the same type for their response with this status code,
+// and returns this type.
+func (p *generatedPackage) assertShared(t *testing.T, code int, operations ...string) string {
+	t.Helper()
+
+	var shared string
+	for _, operation := range operations {
+		typeName, ok := p.uses[operation][code]
+		if !assert.Truef(t, ok, "in %s: no response type found for operation %s and status %s (found: %v)",
+			p.dir, operation, statusLabel(code), p.uses[operation]) {
+			continue
+		}
+
+		if shared == "" {
+			shared = typeName
+
+			continue
+		}
+
+		assert.Equalf(t, shared, typeName,
+			"in %s: operations %v should use the same type for their %s response",
+			p.dir, operations, statusLabel(code))
+	}
+
+	if shared != "" {
+		assert.Equalf(t, code, p.statuses[shared], "in %s: type %s should be the response for status %s",
+			p.dir, shared, statusLabel(code))
+	}
+
+	return shared
+}
+
+// assertTypesByStatus checks how many response types are declared for some status codes.
+func (p *generatedPackage) assertTypesByStatus(t *testing.T, expected map[int]int) {
+	t.Helper()
+
+	byStatus := make(map[int][]string)
+	for typeName, code := range p.statuses {
+		byStatus[code] = append(byStatus[code], typeName)
+	}
+
+	for code, count := range expected {
+		types := byStatus[code]
+		slices.Sort(types)
+		assert.Lenf(t, types, count, "in %s: unexpected response types for status %s: %v",
+			p.dir, statusLabel(code), types)
+	}
+}
+
+func receiverType(fn *ast.FuncDecl) string {
+	if len(fn.Recv.List) == 0 {
+		return ""
+	}
+
+	expr := fn.Recv.List[0].Type
+	if star, ok := expr.(*ast.StarExpr); ok {
+		expr = star.X
+	}
+
+	if ident, ok := expr.(*ast.Ident); ok {
+		return ident.Name
+	}
+
+	return ""
+}
+
+// statusCode reads a status code from a literal, or -1 when the code is not constant (default response).
+func statusCode(expr ast.Expr) int {
+	lit, ok := expr.(*ast.BasicLit)
+	if !ok || lit.Kind != token.INT {
+		return defaultStatus
+	}
+
+	code, err := strconv.Atoi(lit.Value)
+	if err != nil {
+		return defaultStatus
+	}
+
+	return code
+}
+
+// constructedType finds the response type built in some statements of a reader, e.g. result := NewXYZ().
+func constructedType(stmts []ast.Stmt) string {
+	var constructed string
+	for _, stmt := range stmts {
+		ast.Inspect(stmt, func(node ast.Node) bool {
+			if constructed != "" {
+				return false
+			}
+
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+
+			if ident, ok := call.Fun.(*ast.Ident); ok && strings.HasPrefix(ident.Name, "New") {
+				constructed = strings.TrimPrefix(ident.Name, "New")
+
+				return false
+			}
+
+			return true
+		})
+	}
+
+	return constructed
+}
+
+func statusLabel(code int) string {
+	if code == defaultStatus {
+		return "default"
+	}
+
+	return strconv.Itoa(code)
+}
+
+// sharedResponsesClientProgram exercises the generated client with responses from the widgets.yaml fixture.
+const sharedResponsesClientProgram = `package operations
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+	"reflect"
+	"testing"
+
+	"github.com/go-openapi/runtime"
+	"github.com/go-openapi/strfmt"
+)
+
+type fakeResponse struct {
+	code    int
+	headers http.Header
+	body    string
+}
+
+func (r fakeResponse) Code() int                       { return r.code }
+func (r fakeResponse) Message() string                 { return http.StatusText(r.code) }
+func (r fakeResponse) GetHeader(name string) string    { return r.headers.Get(name) }
+func (r fakeResponse) GetHeaders(name string) []string { return r.headers.Values(name) }
+func (r fakeResponse) Body() io.ReadCloser             { return io.NopCloser(bytes.NewBufferString(r.body)) }
+
+// read returns the response read by a reader: errors are responses too.
+func read(t *testing.T, reader runtime.ClientResponseReader, code int, body string, headers map[string]string) any {
+	t.Helper()
+
+	h := http.Header{}
+	for k, v := range headers {
+		h.Set(k, v)
+	}
+
+	result, err := reader.ReadResponse(fakeResponse{code: code, headers: h, body: body}, runtime.JSONConsumer())
+	if err != nil {
+		if _, isResponse := err.(interface{ Code() int }); !isResponse {
+			t.Fatalf("unexpected error reading a %d response: %v", code, err)
+		}
+
+		return err
+	}
+
+	return result
+}
+
+// field digs into a response, dereferencing pointers.
+func field(t *testing.T, value any, path ...string) reflect.Value {
+	t.Helper()
+
+	v := reflect.ValueOf(value)
+	for _, name := range path {
+		for v.Kind() == reflect.Pointer || v.Kind() == reflect.Interface {
+			if v.IsNil() {
+				t.Fatalf("nil value before field %s in %T", name, value)
+			}
+			v = v.Elem()
+		}
+
+		v = v.FieldByName(name)
+		if !v.IsValid() {
+			t.Fatalf("no field %s in %T", name, value)
+		}
+	}
+
+	for v.Kind() == reflect.Pointer {
+		if v.IsNil() {
+			t.Fatalf("nil value for %v in %T", path, value)
+		}
+		v = v.Elem()
+	}
+
+	return v
+}
+
+func code(t *testing.T, response any) int {
+	t.Helper()
+
+	withCode, ok := response.(interface{ Code() int })
+	if !ok {
+		t.Fatalf("%T has no status code", response)
+	}
+
+	return withCode.Code()
+}
+
+func sameType(t *testing.T, what string, responses ...any) {
+	t.Helper()
+
+	for _, response := range responses[1:] {
+		if reflect.TypeOf(response) != reflect.TypeOf(responses[0]) {
+			t.Errorf("%s: expected the same type, but got %T and %T", what, responses[0], response)
+		}
+	}
+}
+
+func TestSharedResponsesAtRuntime(t *testing.T) {
+	formats := strfmt.Default
+
+	const forbiddenBody = ` + "`" + `{"message":"no way","details":[{"field":"name"}]}` + "`" + `
+	forbiddenHeaders := map[string]string{"X-Trace-Id": "trace-1"}
+
+	listForbidden := read(t, &ListWidgetsReader{formats: formats}, 403, forbiddenBody, forbiddenHeaders)
+	createForbidden := read(t, &CreateWidgetReader{formats: formats}, 403, forbiddenBody, forbiddenHeaders)
+	getForbidden := read(t, &GetWidgetReader{formats: formats}, 403, forbiddenBody, forbiddenHeaders)
+	sameType(t, "forbidden", listForbidden, createForbidden, getForbidden)
+
+	for _, response := range []any{listForbidden, createForbidden, getForbidden} {
+		if got := code(t, response); got != 403 {
+			t.Errorf("expected status 403, got %d", got)
+		}
+		if got := field(t, response, "Payload", "Message").String(); got != "no way" {
+			t.Errorf("unexpected message in payload: %q", got)
+		}
+		details := field(t, response, "Payload", "Details")
+		if details.Len() != 1 || field(t, details.Index(0).Interface(), "Field").String() != "name" {
+			t.Errorf("unexpected details in payload: %v", details)
+		}
+		if got := field(t, response, "XTraceID").String(); got != "trace-1" {
+			t.Errorf("unexpected trace id header: %q", got)
+		}
+	}
+
+	updateForbidden := read(t, &UpdateWidgetReader{formats: formats}, 403, ` + "`" + `{"reason":"locked"}` + "`" + `, nil)
+	if reflect.TypeOf(updateForbidden) == reflect.TypeOf(listForbidden) {
+		t.Errorf("an inline response must not use the type of a named response")
+	}
+
+	deleteUnauthorized := read(t, &DeleteWidgetReader{formats: formats}, 401, forbiddenBody, nil)
+	archiveUnauthorized := read(t, &ArchiveWidgetReader{formats: formats}, 401, forbiddenBody, nil)
+	sameType(t, "unauthorized", deleteUnauthorized, archiveUnauthorized)
+	if reflect.TypeOf(deleteUnauthorized) == reflect.TypeOf(listForbidden) {
+		t.Errorf("a named response used under different status codes needs a type for each status code")
+	}
+	if got := code(t, deleteUnauthorized); got != 401 {
+		t.Errorf("expected status 401, got %d", got)
+	}
+
+	// the default response carries the actual status code
+	const problem = ` + "`" + `{"code":7,"message":"bad gateway"}` + "`" + `
+	listUnexpected := read(t, &ListWidgetsReader{formats: formats}, 502, problem, nil)
+	createUnexpected := read(t, &CreateWidgetReader{formats: formats}, 503, problem, map[string]string{"X-Rate-Limit": "5"})
+	updateUnexpected := read(t, &UpdateWidgetReader{formats: formats}, 504, problem, nil)
+	sameType(t, "default", listUnexpected, createUnexpected, updateUnexpected)
+	if got := code(t, listUnexpected); got != 502 {
+		t.Errorf("expected status 502, got %d", got)
+	}
+	if got := code(t, createUnexpected); got != 503 {
+		t.Errorf("expected status 503, got %d", got)
+	}
+	if got := field(t, listUnexpected, "Payload", "Code").Int(); got != 7 {
+		t.Errorf("unexpected code in payload: %d", got)
+	}
+	if got := field(t, listUnexpected, "XRateLimit").Int(); got != 100 {
+		t.Errorf("expected the default value of the rate limit header, got %d", got)
+	}
+	if got := field(t, createUnexpected, "XRateLimit").Int(); got != 5 {
+		t.Errorf("unexpected rate limit header: %d", got)
+	}
+
+	getInternalError := read(t, &GetWidgetReader{formats: formats}, 500, problem, nil)
+	updateInternalError := read(t, &UpdateWidgetReader{formats: formats}, 500, problem, nil)
+	sameType(t, "internal server error", getInternalError, updateInternalError)
+	if reflect.TypeOf(getInternalError) == reflect.TypeOf(listUnexpected) {
+		t.Errorf("the default response must not share its type with a response for an explicit status code")
+	}
+
+	// a shared success response
+	const widget = ` + "`" + `{"id":"w1","name":"gear"}` + "`" + `
+	got := read(t, &GetWidgetReader{formats: formats}, 200, widget, map[string]string{"ETag": "v1"})
+	updated := read(t, &UpdateWidgetReader{formats: formats}, 200, widget, map[string]string{"ETag": "v2"})
+	sameType(t, "widget found", got, updated)
+	if name := field(t, got, "Payload", "Name").String(); name != "gear" {
+		t.Errorf("unexpected widget name: %q", name)
+	}
+	if etag := field(t, updated, "ETag").String(); etag != "v2" {
+		t.Errorf("unexpected etag: %q", etag)
+	}
+}
+`
