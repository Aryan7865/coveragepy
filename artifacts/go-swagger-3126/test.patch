@@ -0,0 +1,956 @@
+// SPDX-FileCopyrightText: Copyright 2015-2025 go-swagger maintainers
+// SPDX-License-Identifier: Apache-2.0
+
+package generator
+
+import (
+	"context"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-openapi/analysis"
+	"github.com/go-openapi/testify/v2/assert"
+	"github.com/go-openapi/testify/v2/require"
+)
+
+const sharedResponsesFixtures = "../fixtures/enhancements/shared-responses-5d81c9"
+
+const defaultStatus = -1 // stands for the default response
+
+func TestSharedNamedResponsesWithinPackage(t *testing.T) {
+	t.Parallel()
+	defer discardOutput()()
+
+	target := newSharedResponsesModule(t)
+	spec := filepath.Join(sharedResponsesFixtures, "widgets.yaml")
+	generateSharedResponsesServer(t, spec, target)
+	generateSharedResponsesClient(t, spec, target)
+
+	// client operations use shared types
+	client := inspectGeneratedPackage(t, filepath.Join(target, "client", "operations"))
+
+	forbidden := client.assertShared(t, 403, "ListWidgets", "CreateWidget", "GetWidget")
+	unauthorized := client.assertShared(t, 401, "DeleteWidget", "ArchiveWidget")
+	assert.NotEqualf(t, forbidden, unauthorized,
+		"a named response used under different status codes needs a type for each status code")
+	client.assertShared(t, 404, "ListWidgets", "GetWidget", "DeleteWidget")
+	client.assertShared(t, 200, "GetWidget", "UpdateWidget")
+	internalError := client.assertShared(t, 500, "GetWidget", "UpdateWidget")
+	unexpected := client.assertShared(t, defaultStatus, "ListWidgets", "CreateWidget", "UpdateWidget")
+	assert.NotEqualf(t, internalError, unexpected,
+		"the default response is not shared with a response for an explicit status code")
+
+	// responses that are not shared keep their own type
+	assert.Equal(t, "UpdateWidgetForbidden", client.uses["UpdateWidget"][403], "inline response")
+	assert.Equal(t, "ArchiveWidgetConflict", client.uses["ArchiveWidget"][409], "named response used once")
+	assert.Equal(t, "ListWidgetsOK", client.uses["ListWidgets"][200])
+	assert.Equal(t, "CreateWidgetCreated", client.uses["CreateWidget"][201])
+
+	expected := map[int]int{
+		200: 2, 201: 1, 204: 2, 401: 1, 403: 2, 404: 1, 409: 1, 500: 1, defaultStatus: 1,
+	}
+	client.assertTypesByStatus(t, expected)
+
+	// the server declares each shared response once
+	server := inspectGeneratedPackage(t, filepath.Join(target, "restapi", "operations"))
+	server.assertTypesByStatus(t, expected)
+
+	runGoInModule(t, target, "build", "./...")
+}
+
+func TestSharedNamedResponsesClientBehavior(t *testing.T) {
+	t.Parallel()
+	defer discardOutput()()
+
+	target := newSharedResponsesModule(t)
+	spec := filepath.Join(sharedResponsesFixtures, "widgets.yaml")
+	generateSharedResponsesClient(t, spec, target)
+
+	operations := filepath.Join(target, "client", "operations")
+	require.NoError(t, os.WriteFile(filepath.Join(operations, "shared_behavior_test.go"), []byte(sharedResponsesClientProgram), 0o600))
+
+	runGoInModule(t, target, "test", "-count=1", "./client/operations/")
+}
+
+func TestSharedNamedResponsesKeepStatusCodes(t *testing.T) {
+	t.Parallel()
+	defer discardOutput()()
+
+	target := newSharedResponsesModule(t)
+	spec := filepath.Join(sharedResponsesFixtures, "partitions.yaml")
+	generateSharedResponsesServer(t, spec, target)
+	generateSharedResponsesClient(t, spec, target)
+
+	{
+		pkg := inspectGeneratedPackage(t, filepath.Join(target, "client", "operations"))
+
+		// a named response with an x-go-name, shared under two status codes
+		unauthorized := pkg.assertShared(t, 401, "GetA", "GetB", "GetC")
+		forbidden := pkg.assertShared(t, 403, "GetA", "GetB")
+		assert.NotEqual(t, unauthorized, forbidden)
+
+		// another named response with the same x-go-name, used as the default response
+		unexpected := pkg.assertShared(t, defaultStatus, "GetA", "GetB")
+		assert.NotContains(t, []string{unauthorized, forbidden}, unexpected)
+
+		// distinct named responses with the same x-go-name under the same status code
+		first := pkg.assertShared(t, 409, "GetC", "GetE")
+		second := pkg.assertShared(t, 409, "GetD", "GetF")
+		assert.NotEqualf(t, first, second, "different named responses must not share a type")
+
+		// a named response used by a single operation, under two status codes
+		lonelyUnauthorized := pkg.uses["GetG"][401]
+		lonelyForbidden := pkg.uses["GetG"][403]
+		assert.NotEqual(t, lonelyUnauthorized, lonelyForbidden)
+		assert.Equal(t, 401, pkg.statuses[lonelyUnauthorized])
+		assert.Equal(t, 403, pkg.statuses[lonelyForbidden])
+		assert.NotContains(t, []string{unauthorized, forbidden}, lonelyUnauthorized)
+		assert.NotContains(t, []string{unauthorized, forbidden}, lonelyForbidden)
+
+		pkg.assertTypesByStatus(t, map[int]int{401: 2, 403: 2, 409: 2, defaultStatus: 1})
+	}
+
+	server := inspectGeneratedPackage(t, filepath.Join(target, "restapi", "operations"))
+	server.assertTypesByStatus(t, map[int]int{401: 2, 403: 2, 409: 2, defaultStatus: 1})
+
+	runGoInModule(t, target, "build", "./...")
+}
+
+func TestSharedNamedResponsesPerPackage(t *testing.T) {
+	t.Parallel()
+	defer discardOutput()()
+
+	target := newSharedResponsesModule(t)
+	spec := filepath.Join(sharedResponsesFixtures, "tagged.yaml")
+	generateSharedResponsesServer(t, spec, target)
+	generateSharedResponsesClient(t, spec, target)
+
+	for _, side := range []struct {
+		name string
+		root string
+	}{
+		{name: "client", root: filepath.Join(target, "client")},
+		{name: "server", root: filepath.Join(target, "restapi", "operations")},
+	} {
+		{
+			untaggedDir := filepath.Join(side.root, "operations")
+			if side.name == "server" {
+				untaggedDir = side.root
+			}
+
+			pets := inspectGeneratedPackage(t, filepath.Join(side.root, "pets"))
+			stores := inspectGeneratedPackage(t, filepath.Join(side.root, "stores"))
+			orders := inspectGeneratedPackage(t, filepath.Join(side.root, "orders"))
+			untagged := inspectGeneratedPackage(t, untaggedDir)
+
+			// each package declares its own types, and does not refer to another package of operations
+			pets.assertTypesByStatus(t, map[int]int{403: 1, defaultStatus: 1})
+			stores.assertTypesByStatus(t, map[int]int{403: 1, defaultStatus: 1})
+			orders.assertTypesByStatus(t, map[int]int{403: 1, defaultStatus: 1})
+			untagged.assertTypesByStatus(t, map[int]int{defaultStatus: 1})
+
+			for _, pkg := range []*generatedPackage{pets, stores, orders} {
+				for _, imported := range pkg.imports {
+					assert.Falsef(t, strings.HasPrefix(imported, "example.com/sharedresponses/client/") ||
+						strings.HasPrefix(imported, "example.com/sharedresponses/restapi/operations"),
+						"package %s should not depend on another package of operations, but imports %s", pkg.dir, imported)
+				}
+			}
+
+			if side.name == "client" {
+				pets.assertShared(t, 403, "ListPets", "AddPet")
+				pets.assertShared(t, defaultStatus, "ListPets", "AddPet")
+				// listStorePets is generated with the operations tagged "stores"
+				stores.assertShared(t, 403, "ListStores", "ListStorePets")
+				untagged.assertShared(t, defaultStatus, "Health", "Version")
+			}
+		}
+	}
+
+	runGoInModule(t, target, "build", "./...")
+}
