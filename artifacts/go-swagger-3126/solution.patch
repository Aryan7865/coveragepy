diff --git a/generator/response_sharing.go b/generator/response_sharing.go
new file mode 100644
index 00000000..943987d0
--- /dev/null
+++ b/generator/response_sharing.go
@@ -0,0 +1,886 @@
+// SPDX-FileCopyrightText: Copyright 2015-2025 go-swagger maintainers
+// SPDX-License-Identifier: Apache-2.0
+
+package generator
+
+import (
+	"encoding/json"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"log"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/go-openapi/loads"
+	"github.com/go-openapi/runtime"
+	"github.com/go-openapi/spec"
+)
+
+// Sharing responses between operations
+//
+// A response declared in the "responses" section of a spec and referenced (with a $ref) by several
+// operations is rendered as a single type, which is declared once in each package that holds some of these
+// operations.
+//
+// Operations share a type for a response only when they are generated in the same package and use this
+// response under the same status code (the default response counts as its own status code): types for responses
+// carry their status code. A response referenced by a single operation of a package keeps its usual
+// operation-specific type.
+//
+// The declaration of a shared response is rendered in a file of its own, from the "shared_responses" section of
+// the layout. Its content doesn't depend on which operations are selected for generation: generating a subset of
+// the operations (or a single operation) produces the same declaration as a full generation.
+
+const defaultResponseCode = -1
+
+// namedResponse identifies a response from the "responses" section of a spec document.
+type namedResponse struct {
+	// ID is the canonical location of the response, e.g. file:///api/spec.yaml#/responses/NotFound.
+	ID string
+	// Key is the key of the response in the "responses" section.
+	Key string
+}
+
+// responseSlot locates a response of an operation: the default response has code -1.
+type responseSlot struct {
+	Method string
+	Path   string
+	Code   int
+}
+
+// namedResponses tells which named response (if any) was referenced by an operation
+// for a given status code, before the spec was flattened.
+type namedResponses map[responseSlot]namedResponse
+
+// collectNamedResponses finds all responses of operations that refer to a named response.
+//
+// This must run before flattening the spec, as flattening expands responses and the reference to a named response is
+// lost after that.
+func collectNamedResponses(doc *loads.Document, loader loads.DocLoader) namedResponses {
+	swspec := doc.Spec()
+	if swspec == nil || swspec.Paths == nil {
+		return nil
+	}
+
+	root := documentURL(doc.SpecFilePath())
+	found := make(namedResponses)
+
+	for path, pathItem := range swspec.Paths.Paths {
+		item, base := pathItem, root
+
+		if pathItem.Ref.String() != "" {
+			// the path item is defined elsewhere: $ref's in there are relative to the document holding it
+			resolved, err := spec.ResolvePathItemWithBase(swspec, pathItem.Ref, &spec.ExpandOptions{
+				RelativeBase:          doc.SpecFilePath(),
+				PathLoaderWithOptions: loader,
+			})
+			if err != nil {
+				// this is reported when flattening the spec
+				continue
+			}
+
+			item = *resolved
+			base = resolveURL(root, pathItem.Ref.GetURL())
+			base.Fragment = ""
+		}
+
+		for method, operation := range pathItemOperations(item) {
+			if operation == nil || operation.Responses == nil {
+				continue
+			}
+
+			if response := operation.Responses.Default; response != nil {
+				found.add(responseSlot{Method: method, Path: path, Code: defaultResponseCode}, base, response.Ref)
+			}
+
+			for code, response := range operation.Responses.StatusCodeResponses {
+				found.add(responseSlot{Method: method, Path: path, Code: code}, base, response.Ref)
+			}
+		}
+	}
+
+	return found
+}
+
+func (n namedResponses) add(slot responseSlot, base *url.URL, ref spec.Ref) {
+	if ref.String() == "" {
+		return
+	}
+
+	target := resolveURL(base, ref.GetURL())
+	key, ok := responseKeyFromFragment(target.Fragment)
+	if !ok {
+		// not a named response, e.g. a JSON pointer to the response of another operation
+		return
+	}
+
+	n[slot] = namedResponse{
+		ID:  target.String(),
+		Key: key,
+	}
+}
+
+// mayBeShared tells if some named response is referred to more than once under the same status code.
+func (n namedResponses) mayBeShared() bool {
+	type use struct {
+		id   string
+		code int
+	}
+	seen := make(map[use]bool, len(n))
+
+	for slot, named := range n {
+		key := use{id: named.ID, code: slot.Code}
+		if seen[key] {
+			return true
+		}
+		seen[key] = true
+	}
+
+	return false
+}
+
+func (n namedResponses) lookup(method, path string, code int) (namedResponse, bool) {
+	named, ok := n[responseSlot{Method: strings.ToUpper(method), Path: path, Code: code}]
+
+	return named, ok
+}
+
+// responseKeyFromFragment recognizes JSON pointers such as "/responses/NotFound".
+func responseKeyFromFragment(fragment string) (string, bool) {
+	const responsesSection = "/responses/"
+
+	key, ok := strings.CutPrefix(fragment, responsesSection)
+	if !ok || key == "" || strings.Contains(key, "/") {
+		return "", false
+	}
+
+	// unescape the JSON pointer token
+	key = strings.ReplaceAll(key, "~1", "/")
+	key = strings.ReplaceAll(key, "~0", "~")
+
+	return key, true
+}
+
+func pathItemOperations(item spec.PathItem) map[string]*spec.Operation {
+	return map[string]*spec.Operation{
+		http.MethodGet:     item.Get,
+		http.MethodPut:     item.Put,
+		http.MethodPost:    item.Post,
+		http.MethodDelete:  item.Delete,
+		http.MethodOptions: item.Options,
+		http.MethodHead:    item.Head,
+		http.MethodPatch:   item.Patch,
+	}
+}
+
+// documentURL builds an absolute URL for the location of a spec document.
+func documentURL(location string) *url.URL {
+	const minSchemeLength = 2 // tells apart URLs from windows paths such as C:\spec.yaml
+
+	if u, err := url.Parse(location); err == nil && u.IsAbs() && len(u.Scheme) >= minSchemeLength && u.Scheme != "file" {
+		return u
+	}
+
+	location = strings.TrimPrefix(location, "file://")
+	if abs, err := filepath.Abs(location); err == nil {
+		location = abs
+	}
+
+	return &url.URL{Scheme: "file", Path: filepath.ToSlash(location)}
+}
+
+func resolveURL(base, ref *url.URL) *url.URL {
+	if ref == nil {
+		u := *base
+
+		return &u
+	}
+
+	return base.ResolveReference(ref)
+}
+
+// sharedResponseKey identifies a response shared by several operations in a package.
+type sharedResponseKey struct {
+	Package string // the package holding the operations, see [operationPackageKey]
+	ID      string // the named response, see [namedResponse]
+	Code    int    // the status code of the response (-1 for the default response)
+}
+
+// sharedResponse is a response shared by several operations in a package.
+type sharedResponse struct {
+	Key        sharedResponseKey
+	Name       string   // the name for the shared type
+	Operations []string // sorted names of the operations using this response
+}
+
+// sharedResponsePlan tells which responses are shared by which operations, and how they are named.
+type sharedResponsePlan struct {
+	byOperation map[string]map[int]*sharedResponse
+}
+
+func (p *sharedResponsePlan) isEmpty() bool {
+	return p == nil || len(p.byOperation) == 0
+}
+
+// forOperation returns the shared responses of an operation, indexed by status code.
+func (p *sharedResponsePlan) forOperation(name string) map[int]*sharedResponse {
+	if p == nil {
+		return nil
+	}
+
+	return p.byOperation[name]
+}
+
+// sharedResponseDeclarations collects the declarations of shared responses, as operations are built.
+//
+// A shared response is built once, with the first operation using it (see [codeGenOpBuilder.makeSharedResponse]).
+type sharedResponseDeclarations map[*sharedResponse]GenSharedResponse
+
+func (d sharedResponseDeclarations) collect(b *codeGenOpBuilder, operation GenOperation) {
+	for code, declared := range b.sharedDeclarations {
+		shared := b.SharedResponses[code]
+		if _, ok := d[shared]; ok {
+			continue
+		}
+
+		d[shared] = newGenSharedResponse(b.GenOpts, operation, shared, declared)
+	}
+}
+
+// forOperations returns the declarations of the shared responses used by the given operations.
+func (d sharedResponseDeclarations) forOperations(operations GenOperations, imports, defaultImports map[string]string) []GenSharedResponse {
+	if len(d) == 0 {
+		return nil
+	}
+
+	seen := make(map[*sharedResponse]bool)
+	var declarations []GenSharedResponse
+
+	for _, operation := range operations {
+		for shared, declaration := range d {
+			if seen[shared] || !slices.Contains(shared.Operations, operation.Name) {
+				continue
+			}
+			seen[shared] = true
+
+			declaration.Imports = imports
+			declaration.DefaultImports = defaultImports
+			declarations = append(declarations, declaration)
+		}
+	}
+
+	slices.SortFunc(declarations, func(a, b GenSharedResponse) int { return strings.Compare(a.Name, b.Name) })
+
+	return declarations
+}
+
+// sharedDeclaration is what it takes to declare a shared response, as built by an operation.
+type sharedDeclaration struct {
+	Response     GenResponse
+	ExtraSchemas GenSchemaList
+}
+
+func newGenSharedResponse(opts *GenOpts, operation GenOperation, shared *sharedResponse, declared sharedDeclaration) GenSharedResponse {
+	return GenSharedResponse{
+		GenCommon: GenCommon{
+			Copyright:        opts.Copyright,
+			TargetImportPath: opts.LanguageOpts.BaseImport(opts.Target),
+		},
+		Package:          operation.Package,
+		Name:             shared.Name,
+		UseTags:          operation.UseTags,
+		Operations:       shared.Operations,
+		Response:         declared.Response,
+		ExtraSchemas:     declared.ExtraSchemas,
+		DefaultImports:   operation.DefaultImports,
+		Imports:          operation.Imports,
+		StrictResponders: opts.StrictResponders,
+	}
+}
+
+// operationPackageKey identifies the package where an operation is generated.
+func operationPackageKey(pkg string, useTags bool) string {
+	return strconv.FormatBool(useTags) + ":" + pkg
+}
+
+// sharedResponsePlanner decides which responses are shared by several operations of the same package,
+// and finds a name for the types of these responses that doesn't conflict with anything else declared in the package.
+type sharedResponsePlanner struct {
+	opts       *GenOpts
+	named      namedResponses
+	app        *GenApp                     // the app built as if no response were shared
+	builders   map[string]codeGenOpBuilder // the builders for all operations in app, before they made the operation
+	operations map[string]opRef            // the operations, not altered by building the app
+
+	located map[string][]locatedTemplate // templates rendered in each target directory
+	scanned map[string]*packageScan      // declarations found in each target directory
+}
+
+// packageScan collects the names declared at the top level of a package, and its file names.
+type packageScan struct {
+	identifiers map[string]bool
+	files       map[string]bool
+}
+
+func (s *packageScan) conflictsWith(other *packageScan) bool {
+	for identifier := range other.identifiers {
+		if s.identifiers[identifier] {
+			return true
+		}
+	}
+
+	for file := range other.files {
+		if s.files[file] {
+			return true
+		}
+	}
+
+	return false
+}
+
+func (s *packageScan) merge(other *packageScan) {
+	for identifier := range other.identifiers {
+		s.identifiers[identifier] = true
+	}
+
+	for file := range other.files {
+		s.files[file] = true
+	}
+}
+
+func newPackageScan() *packageScan {
+	return &packageScan{
+		identifiers: make(map[string]bool),
+		files:       make(map[string]bool),
+	}
+}
+
+type sharedResponseGroup struct {
+	key        sharedResponseKey
+	named      namedResponse
+	operations []string
+	goName     string // x-go-name set on the named response, if any
+}
+
+func (p *sharedResponsePlanner) plan() (*sharedResponsePlan, error) {
+	groups := p.groups()
+	if len(groups) == 0 {
+		return nil, nil //nolint:nilnil // no shared response is not an error
+	}
+
+	plan := &sharedResponsePlan{byOperation: make(map[string]map[int]*sharedResponse)}
+
+	// named responses shared under several status codes in the same package get one type per status code
+	codesInPackage := make(map[string]int)
+	for _, group := range groups {
+		codesInPackage[group.key.Package+"#"+group.key.ID]++
+	}
+
+	claimed := make(map[string]*packageScan) // names already given to shared responses, by target directory
+	for _, group := range groups {
+		shared, err := p.nameSharedResponse(group, codesInPackage[group.key.Package+"#"+group.key.ID] > 1, claimed)
+		if err != nil {
+			return nil, err
+		}
+
+		for _, operation := range shared.Operations {
+			if plan.byOperation[operation] == nil {
+				plan.byOperation[operation] = make(map[int]*sharedResponse)
+			}
+			plan.byOperation[operation][shared.Key.Code] = shared
+		}
+	}
+
+	return plan, nil
+}
+
+// groups finds the named responses used by at least two operations of the same package, under the same status code.
+func (p *sharedResponsePlanner) groups() []sharedResponseGroup {
+	index := make(map[sharedResponseKey]*sharedResponseGroup)
+
+	for _, operation := range p.app.Operations {
+		pkg := operationPackageKey(operation.Package, operation.UseTags)
+
+		responses := make([]GenResponse, 0, len(operation.Responses)+1)
+		responses = append(responses, operation.Responses...)
+		if operation.DefaultResponse != nil {
+			responses = append(responses, *operation.DefaultResponse)
+		}
+
+		for _, response := range responses {
+			named, ok := p.named.lookup(operation.Method, operation.Path, response.Code)
+			if !ok {
+				continue
+			}
+
+			key := sharedResponseKey{Package: pkg, ID: named.ID, Code: response.Code}
+			group, found := index[key]
+			if !found {
+				goName, _ := spec.Extensions(response.Extensions).GetString(xGoName)
+				group = &sharedResponseGroup{key: key, named: named, goName: goName}
+				index[key] = group
+			}
+
+			group.operations = append(group.operations, operation.Name)
+		}
+	}
+
+	groups := make([]sharedResponseGroup, 0, len(index))
+	for _, group := range index {
+		if len(group.operations) < 2 { //nolint:mnd // sharing requires two operations at least
+			continue
+		}
+
+		slices.Sort(group.operations)
+		groups = append(groups, *group)
+	}
+
+	// names are attributed in a stable order
+	slices.SortFunc(groups, func(a, b sharedResponseGroup) int {
+		if c := strings.Compare(a.key.Package, b.key.Package); c != 0 {
+			return c
+		}
+		if c := strings.Compare(a.key.ID, b.key.ID); c != 0 {
+			return c
+		}
+
+		return compareStatusCodes(a.key.Code, b.key.Code)
+	})
+
+	return groups
+}
+
+// compareStatusCodes sorts status codes, with the default response last.
+func compareStatusCodes(a, b int) int {
+	switch {
+	case a == b:
+		return 0
+	case a == defaultResponseCode:
+		return 1
+	case b == defaultResponseCode:
+		return -1
+	default:
+		return a - b
+	}
+}
+
+// baseName is the name of a shared response, before any conflict is resolved.
+//
+// It is the name of the response in the spec (or its x-go-name), qualified by the status code whenever the same
+// named response is shared under several status codes in the package.
+func (g sharedResponseGroup) baseName(qualifyWithCode bool) string {
+	name := g.named.Key
+	if g.goName != "" {
+		name = g.goName
+	}
+
+	if !qualifyWithCode {
+		return name
+	}
+
+	if g.key.Code == defaultResponseCode {
+		return name + " default"
+	}
+
+	return name + " " + statusName(g.key.Code)
+}
+
+// statusName is the name used for a status code when naming the type of a response.
+func statusName(code int) string {
+	if name := runtime.Statuses[code]; name != "" {
+		return name
+	}
+
+	// non-standard codes deserve some name
+	return fmt.Sprintf("Status %d", code)
+}
+
+// nameSharedResponse picks a name for the type of a shared response, which doesn't conflict with any other
+// declaration in the target package (or its files).
+func (p *sharedResponsePlanner) nameSharedResponse(group sharedResponseGroup, qualifyWithCode bool, claimed map[string]*packageScan) (*sharedResponse, error) {
+	mangler := p.opts.LanguageOpts.Mangler
+	base := group.baseName(qualifyWithCode)
+	representative := group.operations[0]
+
+	// the names declared in a package are finite: some candidate is eventually free
+	for attempt := 0; ; attempt++ {
+		candidate := base
+		switch attempt {
+		case 0:
+		case 1:
+			candidate += " response"
+		default:
+			candidate += " response " + strconv.Itoa(attempt)
+		}
+
+		shared := &sharedResponse{
+			Key:        group.key,
+			Name:       mangler.ToJSONName(candidate),
+			Operations: group.operations,
+		}
+
+		declaration, err := p.declare(representative, shared)
+		if err != nil {
+			return nil, err
+		}
+
+		rendered, err := p.renderDeclaration(&declaration)
+		if err != nil {
+			return nil, err
+		}
+
+		conflict := false
+		for dir, scan := range rendered {
+			existing, err := p.scan(dir)
+			if err != nil {
+				return nil, err
+			}
+
+			if existing.conflictsWith(scan) || claimed[dir] != nil && claimed[dir].conflictsWith(scan) {
+				conflict = true
+
+				break
+			}
+		}
+
+		if conflict {
+			debugLogf("name %q for shared response %s conflicts with another declaration", shared.Name, group.named.ID)
+
+			continue
+		}
+
+		for dir, scan := range rendered {
+			if claimed[dir] == nil {
+				claimed[dir] = newPackageScan()
+			}
+			claimed[dir].merge(scan)
+		}
+
+		return shared, nil
+	}
+}
+
+// declare builds the declaration of a shared response, from one of the operations using it.
+func (p *sharedResponsePlanner) declare(operationName string, shared *sharedResponse) (GenSharedResponse, error) {
+	bldr, ok := p.builders[operationName]
+	opRef, found := p.operations[operationName]
+	if !ok || !found {
+		return GenSharedResponse{}, fmt.Errorf("internal error: operation %q not found", operationName)
+	}
+
+	var operation GenOperation
+	for _, op := range p.app.Operations {
+		if op.Name == operationName {
+			operation = op
+
+			break
+		}
+	}
+
+	// building a response alters its schema: work with a copy of the response, as it is in the spec
+	response, err := cloneResponse(opRef.Op, shared.Key.Code)
+	if err != nil {
+		return GenSharedResponse{}, err
+	}
+
+	bldr.ExtraSchemas = nil
+	bldr.sharedDeclarations = nil
+	bldr.builtSharedResponses = nil
+	resolver := newTypeResolver(
+		bldr.GenOpts.LanguageOpts.ManglePackageName(bldr.ModelsPackage, defaultModelsTarget),
+		bldr.Doc,
+		bldr.GenOpts,
+	)
+
+	if _, err := bldr.makeSharedResponse("o", resolver, shared, isSuccessCode(shared.Key.Code), shared.Key.Code, response); err != nil {
+		return GenSharedResponse{}, err
+	}
+
+	return newGenSharedResponse(p.opts, operation, shared, bldr.sharedDeclarations[shared.Key.Code]), nil
+}
+
+func cloneResponse(operation *spec.Operation, code int) (spec.Response, error) {
+	var response spec.Response
+	if operation == nil || operation.Responses == nil {
+		return response, nil
+	}
+
+	var source *spec.Response
+	if code == defaultResponseCode {
+		source = operation.Responses.Default
+	} else if r, ok := operation.Responses.StatusCodeResponses[code]; ok {
+		source = &r
+	}
+	if source == nil {
+		return response, nil
+	}
+
+	raw, err := json.Marshal(source)
+	if err != nil {
+		return response, err
+	}
+
+	err = json.Unmarshal(raw, &response)
+
+	return response, err
+}
+
+func isSuccessCode(code int) bool {
+	const (
+		httpStatusCodeDivider = 100
+		httpStatusCodeSuccess = 2
+	)
+
+	return code != defaultResponseCode && code/httpStatusCodeDivider == httpStatusCodeSuccess
+}
+
+// renderDeclaration renders (without writing) the declaration of a shared response and tells what it declares,
+// in which target directory.
+func (p *sharedResponsePlanner) renderDeclaration(declaration *GenSharedResponse) (map[string]*packageScan, error) {
+	r := newRenderer(p.opts)
+	scans := make(map[string]*packageScan)
+
+	for _, tp := range p.opts.Sections.SharedResponses {
+		templ := tp
+		dir, file, err := r.location(&templ, declaration)
+		if err != nil {
+			return nil, err
+		}
+
+		content, err := r.render(&templ, declaration)
+		if err != nil {
+			return nil, err
+		}
+
+		if scans[dir] == nil {
+			scans[dir] = newPackageScan()
+		}
+		scans[dir].files[file] = true
+		if err := collectDeclarations(file, content, scans[dir].identifiers); err != nil {
+			return nil, fmt.Errorf("rendering shared response %s: %w", declaration.Name, err)
+		}
+	}
+
+	return scans, nil
+}
+
+// scan collects the top-level declarations and file names of all generated sources in a target directory.
+//
+// The declarations for shared responses are not known yet: operations are rendered as if no response were
+// shared, so the declarations of their own responses are also collected.
+func (p *sharedResponsePlanner) scan(dir string) (*packageScan, error) {
+	if scan, ok := p.scanned[dir]; ok {
+		return scan, nil
+	}
+
+	if err := p.locateTemplates(); err != nil {
+		return nil, err
+	}
+
+	r := newRenderer(p.opts)
+	scan := newPackageScan()
+
+	for _, located := range p.located[dir] {
+		templ := located.template
+		scan.files[located.file] = true
+
+		var (
+			content []byte
+			err     error
+		)
+		if templ.SkipExists && fileExists(dir, located.file) {
+			content, err = os.ReadFile(filepath.Join(dir, located.file))
+		} else {
+			content, err = r.render(&templ, located.data)
+		}
+		if err != nil {
+			return nil, err
+		}
+
+		if err := collectDeclarations(located.file, content, scan.identifiers); err != nil {
+			// not go source, or broken: this will be reported when formatting generated code
+			log.Printf("could not parse declarations for %s: %v", located.file, err)
+		}
+	}
+
+	p.scanned[dir] = scan
+
+	return scan, nil
+}
+
+// locatedTemplate is a template to render with some data, in a target directory.
+type locatedTemplate struct {
+	template TemplateOpts
+	data     any
+	file     string
+}
+
+// locateTemplates finds out where the templates of operations, operation groups and of the application are rendered.
+func (p *sharedResponsePlanner) locateTemplates() error {
+	if p.located != nil {
+		return nil
+	}
+
+	r := newRenderer(p.opts)
+	p.located = make(map[string][]locatedTemplate)
+
+	locate := func(templates []TemplateOpts, data any) error {
+		for _, tp := range templates {
+			templ := tp
+			dir, file, err := r.location(&templ, data)
+			if err != nil {
+				return err
+			}
+
+			p.located[dir] = append(p.located[dir], locatedTemplate{template: templ, data: data, file: file})
+		}
+
+		return nil
+	}
+
+	for i := range p.app.Operations {
+		if err := locate(p.opts.Sections.Operations, &p.app.Operations[i]); err != nil {
+			return err
+		}
+	}
+
+	for i := range p.app.OperationGroups {
+		if err := locate(p.opts.Sections.OperationGroups, &p.app.OperationGroups[i]); err != nil {
+			return err
+		}
+	}
+
+	// models may be generated into the same package as operations
+	for i := range p.app.Models {
+		if err := locate(p.opts.Sections.Models, &p.app.Models[i]); err != nil {
+			return err
+		}
+	}
+
+	var application []TemplateOpts
+	for _, tp := range p.opts.Sections.Application {
+		templ := tp
+		if r.shouldRenderApp(&templ, p.app) {
+			application = append(application, templ)
+		}
+	}
+
+	return locate(application, p.app)
+}
+
+// collectDeclarations adds to identifiers the names declared at the top level of a go source.
+func collectDeclarations(file string, content []byte, identifiers map[string]bool) error {
+	if !strings.EqualFold(filepath.Ext(file), ".go") {
+		return nil
+	}
+
+	src, err := parser.ParseFile(token.NewFileSet(), file, content, parser.SkipObjectResolution)
+	if err != nil {
+		return err
+	}
+
+	add := func(name *ast.Ident) {
+		if name.Name != "_" {
+			identifiers[name.Name] = true
+		}
+	}
+
+	for _, decl := range src.Decls {
+		switch d := decl.(type) {
+		case *ast.FuncDecl:
+			if d.Recv == nil && d.Name.Name != "init" {
+				add(d.Name)
+			}
+		case *ast.GenDecl:
+			for _, s := range d.Specs {
+				switch s := s.(type) {
+				case *ast.TypeSpec:
+					add(s.Name)
+				case *ast.ValueSpec:
+					for _, name := range s.Names {
+						add(name)
+					}
+				}
+			}
+		}
+	}
+
+	return nil
+}
+
+// sharedResponse returns the shared response to use for a status code of the operation, if any.
+func (b *codeGenOpBuilder) sharedResponse(code int) *sharedResponse {
+	shared, ok := b.SharedResponses[code]
+	if !ok || shared.Key.Package != b.packageKey() {
+		return nil
+	}
+
+	return shared
+}
+
+func (b *codeGenOpBuilder) packageKey() string {
+	return operationPackageKey(
+		b.GenOpts.LanguageOpts.ManglePackageName(b.APIPackage, defaultOperationsTarget),
+		len(b.Operation.Tags) > 0 && !b.GenOpts.SkipTagPackages,
+	)
+}
+
+// makeSharedResponse builds a response of the operation which refers to a shared response.
+//
+// The type for this response is declared separately (see [GenSharedResponse]), and so are the schemas
+// which may be defined inline in this response: the declaration is kept aside by the builder.
+//
+// A shared response is built only once for all operations using it: building a schema registers the types
+// it defines inline, so building it again would resolve these as models instead.
+// Operations are built in a stable order, so the same operation always builds the response.
+func (b *codeGenOpBuilder) makeSharedResponse(receiver string, resolver *typeResolver, shared *sharedResponse, isSuccess bool, code int, resp spec.Response) (GenResponse, error) {
+	if b.sharedDeclarations == nil {
+		b.sharedDeclarations = make(map[int]sharedDeclaration)
+	}
+
+	if built, ok := b.builtSharedResponses[shared]; ok {
+		response := built.Response
+		response.ReceiverName = receiver
+		response.Method = b.Method
+		response.Path = b.Path
+		response.OperationName = b.Name
+		b.sharedDeclarations[code] = built
+
+		return response, nil
+	}
+
+	extraSchemas := b.ExtraSchemas
+	b.ExtraSchemas = nil
+	defer func() {
+		b.ExtraSchemas = extraSchemas
+	}()
+
+	response, err := b.MakeResponse(receiver, shared.Name, isSuccess, resolver, code, resp)
+	if err != nil {
+		return GenResponse{}, err
+	}
+	response.IsShared = true
+
+	// the declaration is common to all operations using this response
+	declared := response
+	declared.Method = ""
+	declared.Path = ""
+	declared.OperationName = ""
+
+	b.sharedDeclarations[code] = sharedDeclaration{
+		Response:     declared,
+		ExtraSchemas: gatherExtraSchemas(b.ExtraSchemas),
+	}
+	if b.builtSharedResponses != nil {
+		b.builtSharedResponses[shared] = b.sharedDeclarations[code]
+	}
+
+	return response, nil
+}
