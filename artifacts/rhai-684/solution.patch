+    /// Check whether a new variable can be defined, according to the shadowing rules
+    /// and the variable definition filter.
+    fn check_var_definition(
+        &self,
+        state: &mut ParseState,
+        settings: ParseSettings,
+        name: &str,
+        pos: Position,
+        access: AccessMode,
+    ) -> ParseResult<()> {
+        if !self.allow_shadowing() && state.stack.get(name).is_some() {
+            return Err(PERR::VariableExists(name.into()).into_err(pos));
+        }
+
+        if let Some(ref filter) = self.def_var_filter {
+            let will_shadow = state.stack.get(name).is_some();
+
+            let global = state
+                .global
+                .get_or_insert_with(|| self.new_global_runtime_state().into());
+
+            global.level = settings.level;
+            let is_const = access == AccessMode::ReadOnly;
+            let info = VarDefInfo::new(name, is_const, settings.level, will_shadow);
+            let caches = &mut Caches::new();
+            let context = EvalContext::new(self, global, caches, &mut state.stack, None);
+
+            match filter(false, info, context) {
+                Ok(true) => (),
+                Ok(false) => return Err(PERR::ForbiddenVariable(name.into()).into_err(pos)),
+                Err(err) => {
+                    return Err(match *err {
+                        EvalAltResult::ErrorParsing(e, pos) => e.into_err(pos),
+                        _ => PERR::ForbiddenVariable(name.into()).into_err(pos),
+                    })
+                }
+            }
+        }
+
+        Ok(())
+    }
+
+    /// Parse a destructuring variable definition.
+    #[cfg(any(not(feature = "no_index"), not(feature = "no_object")))]
+    fn parse_let_pattern(
+        &self,
+        state: &mut ParseState,
+        settings: ParseSettings,
+        access: AccessMode,
+        is_export: bool,
+    ) -> ParseResult<Stmt> {
+        let (token, pos) = state.input.next().unwrap();
+
+        if is_export {
+            return Err(PERR::WrongExport.into_err(pos));
+        }
+
+        let close = match token {
+            #[cfg(not(feature = "no_index"))]
+            Token::LeftBracket => Token::RightBracket,
+            #[cfg(not(feature = "no_object"))]
+            Token::MapStart => Token::RightBrace,
+            _ => return Err(PERR::VariableExpected.into_err(pos)),
+        };
+
+        let mut vars = FnArgsVec::<Ident>::new();
+
+        loop {
+            if match_token(state.input, &close).0 {
+                break;
+            }
+
+            let (name, pos) = parse_var_name(state.input)?;
+
+            if vars.iter().any(|v| v.name == name) {
+                return Err(PERR::DuplicatedVariable(name.into()).into_err(pos));
+            }
+
+            vars.push(Ident {
+                name: self.get_interned_string(name),
+                pos,
+            });
+
+            match state.input.next().unwrap() {
+                (Token::Comma, ..) => (),
+                (t, ..) if t == close => break,
+                (Token::LexError(err), pos) => return Err(err.into_err(pos)),
+                (.., pos) => {
+                    return Err(PERR::MissingToken(
+                        close.literal_syntax().into(),
+                        "to end the list of variables".into(),
+                    )
+                    .into_err(pos))
+                }
+            }
+        }
+
+        if vars.is_empty() {
+            return Err(PERR::VariableExpected.into_err(pos));
+        }
+
+        // Check the variables before any of them are defined, as they may shadow each other
+        for var in &vars {
+            self.check_var_definition(state, settings, &var.name, var.pos, access)?;
+        }
+
+        // [ ... ] = expr
+        let (has_equals, eq_pos) = match_token(state.input, &Token::Equals);
+        if !has_equals {
+            return Err(PERR::MissingToken(
+                Token::Equals.literal_syntax().into(),
+                "to assign the value to destructure".into(),
+            )
+            .into_err(eq_pos));
+        }
+        let expr = self.parse_expr(state, settings.level_up()?)?;
+
+        for var in &vars {
+            state
+                .stack
+                .push_entry(var.name.clone(), access, Dynamic::UNIT);
+        }
+
+        let pattern = match close {
+            #[cfg(not(feature = "no_index"))]
+            Token::RightBracket => crate::ast::VarPattern::Array(vars),
+            #[cfg(not(feature = "no_object"))]
+            Token::RightBrace => crate::ast::VarPattern::Map(vars),
+            _ => unreachable!("invalid closing token for a destructuring pattern"),
+        };
+
+        let flags = match access {
+            AccessMode::ReadWrite => ASTFlags::empty(),
+            AccessMode::ReadOnly => ASTFlags::CONSTANT,
+        };
+
+        Ok(Stmt::VarPattern(
+            (pattern, expr).into(),
+            flags,
+            settings.pos,
+        ))
+    }
