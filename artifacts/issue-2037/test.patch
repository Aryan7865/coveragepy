+        combined_ab.update(data_b)
+        combined_ba = CoverageData("ba")
+        combined_ba.update(data_b)
+        combined_ba.update(data_a)
+
+        for combined in [combined_ab, combined_ba]:
+            times = combined.line_timestamps(wf)
+            assert times == earliest(lines_a, lines_b)
+            assert times is not None
+            # Lines run in both came from the first run, line 6 only from the second.
