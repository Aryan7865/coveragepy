+class ArcTimestampTest(TimestampTestBase):
+    """Tests of timestamps for branch coverage."""
+
+    def test_every_executed_arc_has_a_time(self) -> None:
+        self.make_file("prog.py", TRUE_ONLY_PY)
+        cov = self.make_cov(branch=True)
+        before, after = self.run_prog(cov, "prog")
+        data = cov.get_data()
+        times = data.arc_timestamps(self.work_file())
+        assert times is not None
+        assert set(times) == set(data.arcs(self.work_file()) or [])
+        assert (3, 4) in times
+        assert (3, 6) not in times
+        assert_times_between(times, before, after)
+
+    def test_first_arc_execution_is_kept(self) -> None:
+        self.make_file("prog.py", PROG_PY)
+        cov = self.make_cov(branch=True)
+        before, after = self.run_prog(cov, "prog")
+        mark = self.prog_attr("mark")
+        data = cov.get_data()
+        times = data.arc_timestamps(self.work_file())
+        assert times is not None
+        assert set(times) == set(data.arcs(self.work_file()) or [])
+        assert_times_between(times, before, after)
+        for arc in [(3, 4), (7, -1)]:
+            assert before <= times[arc] <= mark, arc
+        assert mark < times[3, 6] <= after
+
+    def test_order_of_arcs(self) -> None:
+        self.make_file(
+            "prog.py",
+            """\
+            import clock
+            import work
+
+            work.work(False)
+            mark = clock.tick()
+            work.work(True)
+            """,
+        )
+        cov = self.make_cov(branch=True)
+        self.run_prog(cov, "prog")
+        mark = self.prog_attr("mark")
+        times = cov.get_data().arc_timestamps(self.work_file())
+        assert times is not None
+        assert times[3, 6] <= mark < times[3, 4]
+        assert times[7, -1] <= mark
+
+    def test_line_timestamps_from_branch_data(self) -> None:
+        self.make_file("prog.py", PROG_PY)
+        cov = self.make_cov(branch=True)
+        before, after = self.run_prog(cov, "prog")
+        mark = self.prog_attr("mark")
+        data = cov.get_data()
+        times = data.line_timestamps(self.work_file())
+        assert times is not None
+        assert set(times) == set(data.lines(self.work_file()) or [])
+        for lineno in [2, 3, 4, 7]:
+            assert before <= times[lineno] <= mark
+        assert mark < times[6] <= after
+
+    def test_single_executed_arc(self) -> None:
+        self.make_file("one.py", "x = 1\n")
+        cov = self.make_cov(branch=True)
+        before, after = self.run_prog(cov, "one")
+        data = cov.get_data()
+        times = data.arc_timestamps(abs_file("one.py"))
+        assert times is not None
+        assert set(times) == set(data.arcs(abs_file("one.py")) or [])
+        assert_times_between(times, before, after)
+        line_times = data.line_timestamps(abs_file("one.py"))
+        assert line_times is not None
+        assert list(line_times) == [1]
+
