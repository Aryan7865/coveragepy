+class LifecycleTimestampTest(TimestampTestBase):
+    """Timestamps must survive saving data in the middle of a run."""
+
+    @pytest.mark.parametrize("branch", [False, True])
+    def test_save_during_run_keeps_first_time(self, branch: bool) -> None:
+        cov = self.make_cov(branch=branch)
+        before = time.time()
+        cov.start()
+        try:
+            work = import_local_file("work")
+            clock = import_local_file("clock")
+            work.work(True)
+            mark1 = clock.tick()
+            cov.save()
+            work.work(True)
+            mark2 = clock.tick()
+            cov.save()
+            work.work(True)
+            work.work(False)
+        finally:
+            cov.stop()
+        cov.save()
+        after = time.time()
+
+        data = CoverageData()
+        data.read()
+        times = data.line_timestamps(self.work_file())
+        assert times is not None
+        for lineno in [2, 3, 4, 7]:
+            assert before <= times[lineno] <= mark1
+        assert mark2 < times[6] <= after
+        if branch:
+            arc_times = data.arc_timestamps(self.work_file())
+            assert arc_times is not None
+            assert before <= arc_times[3, 4] <= mark1
+            assert mark2 < arc_times[3, 6] <= after
+
+    @pytest.mark.parametrize("branch", [False, True])
+    def test_context_switches(self, branch: bool) -> None:
+        cov = self.make_cov(branch=branch)
+        before = time.time()
+        cov.start()
+        try:
+            work = import_local_file("work")
+            clock = import_local_file("clock")
+            cov.switch_context("one")
+            work.work(True)
+            mark = clock.tick()
+            cov.switch_context("two")
+            work.work(True)
+            cov.switch_context("one")
+            work.work(True)
+            work.work(False)
+        finally:
+            cov.stop()
+        after = time.time()
+
+        data = cov.get_data()
+        wf = self.work_file()
+
+        data.set_query_contexts(["one"])
+        one_times = data.line_timestamps(wf)
+        assert one_times is not None
+        assert set(one_times) == set(data.lines(wf) or [])
+        for lineno in [2, 3, 4, 7]:
+            assert before <= one_times[lineno] <= mark
+        assert mark < one_times[6] <= after
+        if branch:
+            one_arcs = data.arc_timestamps(wf)
+            assert one_arcs is not None
+            assert one_arcs[3, 4] <= mark < one_arcs[3, 6]
+
+        data.set_query_contexts(["two"])
+        two_times = data.line_timestamps(wf)
+        assert two_times is not None
+        assert set(two_times) == set(data.lines(wf) or [])
+        assert 6 not in two_times
+        for when in two_times.values():
+            assert mark < when <= after
+
+        data.set_query_contexts(None)
+        all_times = data.line_timestamps(wf)
+        assert all_times is not None
+        assert set(all_times) == set(data.lines(wf) or [])
+        for lineno, when in one_times.items():
+            assert all_times[lineno] == when
+
+
+class PersistenceTimestampTest(TimestampTestBase):
+    """Timestamps are stored with the data."""
+
+    @pytest.mark.parametrize("branch", [False, True])
+    def test_reading_data_file(self, branch: bool) -> None:
+        self.make_file("other.py", "def hello():\n    return 'hi'\n")
