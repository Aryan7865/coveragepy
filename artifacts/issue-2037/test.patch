+class CoreTimestampTest(TimestampTestBase):
+    """Timestamps are recorded whichever measurement core is used."""
+
+    def make_core_cov(self, core: str, branch: bool) -> Coverage:
+        """Make a Coverage object that will use `core`."""
+        cov = self.make_cov(branch=branch)
+        cov.set_option("run:core", core)
+        return cov
+
+    def check_core(self, cov: Coverage, tracer_name: str) -> None:
+        """Check that `cov` measured with the tracer we asked for."""
+        assert dict(cov.sys_info())["core"] == tracer_name
+
+    @pytest.mark.parametrize("core, tracer_name, branch", core_params())
+    def test_first_execution(self, core: str, tracer_name: str, branch: bool) -> None:
+        self.make_file("prog.py", PROG_PY)
+        cov = self.make_core_cov(core, branch)
+        before, after = self.run_prog(cov, "prog")
+        self.check_core(cov, tracer_name)
+        mark = self.prog_attr("mark")
+        data = cov.get_data()
+        wf = self.work_file()
+
+        times = data.line_timestamps(wf)
+        assert times is not None
+        assert set(times) == set(data.lines(wf) or [])
+        assert_times_between(times, before, after)
+        for lineno in [2, 3, 4, 7]:
+            assert times[lineno] <= mark
+        assert mark < times[6]
+
+        arc_times = data.arc_timestamps(wf)
+        assert arc_times is not None
+        if branch:
+            assert set(arc_times) == set(data.arcs(wf) or [])
+            assert_times_between(arc_times, before, after)
+            assert arc_times[3, 4] <= mark < arc_times[3, 6]
+        else:
+            assert arc_times == {}
+
+    @pytest.mark.parametrize("core, tracer_name, branch", core_params())
+    def test_save_during_run(self, core: str, tracer_name: str, branch: bool) -> None:
+        cov = self.make_core_cov(core, branch)
+        cov.start()
+        try:
+            work = import_local_file("work")
+            clock = import_local_file("clock")
+            work.work(True)
+            mark = clock.tick()
+            cov.save()
+            work.work(True)
+            work.work(False)
+        finally:
+            cov.stop()
+        cov.save()
+        self.check_core(cov, tracer_name)
+
+        data = CoverageData()
+        data.read()
+        times = data.line_timestamps(self.work_file())
+        assert times is not None
+        assert times[4] <= mark < times[6]
+        if branch:
+            arc_times = data.arc_timestamps(self.work_file())
+            assert arc_times is not None
+            assert arc_times[3, 4] <= mark < arc_times[3, 6]
+
+    @pytest.mark.parametrize("core, tracer_name, branch", core_params())
+    def test_json_report(self, core: str, tracer_name: str, branch: bool) -> None:
+        self.make_file("prog.py", PROG_PY)
+        cov = self.make_core_cov(core, branch)
+        before, _ = self.run_prog(cov, "prog")
