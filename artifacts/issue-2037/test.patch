+class JsonTimestampTest(TimestampTestBase):
+    """Timestamps in the JSON report."""
+
+    def json_report(self, cov: Coverage, **kwargs: Any) -> dict[str, Any]:
+        """Write a JSON report from `cov` and return the parsed JSON."""
+        cov.json_report(outfile="report.json", **kwargs)
+        with open("report.json", encoding="utf-8") as f:
+            report: dict[str, Any] = json.load(f)
+        return report
+
+    def assert_offsets(
+        self,
+        offsets: dict[TLineNo, float] | dict[TArc, float],
+        times: dict[TLineNo, float] | dict[TArc, float],
+    ) -> float:
+        """Check that `offsets` are `times` measured from one start time.
+
+        Returns the start time.
+
+        """
+        assert offsets
+        starts = [times[key] - offset for key, offset in offsets.items()]  # type: ignore[index]
+        start = starts[0]
+        for s in starts:
+            assert s == pytest.approx(start, abs=TOLERANCE)
+        for offset in offsets.values():
+            assert offset >= 0
+        return start
+
+    def file_line_offsets(self, file_data: dict[str, Any]) -> dict[TLineNo, float]:
+        """Get the line offsets from a JSON file entry, with int keys."""
+        return {int(lineno): offset for lineno, offset in file_data["line_timestamps"].items()}
+
+    def file_branch_offsets(self, file_data: dict[str, Any]) -> dict[TArc, float]:
+        """Get the branch offsets from a JSON file entry, as a dict."""
+        offsets = {}
+        for fromno, tono, offset in file_data["branch_timestamps"]:
+            offsets[fromno, tono] = offset
+        assert len(offsets) == len(file_data["branch_timestamps"])
+        return offsets
+
+    def all_entries(self, report: dict[str, Any]) -> list[dict[str, Any]]:
+        """Get every file entry and region entry in a JSON report."""
+        entries = []
+        for file_data in report["files"].values():
+            entries.append(file_data)
+            for kind in ["functions", "classes"]:
+                entries.extend(file_data[kind].values())
+        return entries
+
+    @pytest.mark.parametrize("branch", [False, True])
+    def test_no_timestamps_when_disabled(self, branch: bool) -> None:
+        self.make_file("prog.py", PROG_PY)
+        cov = self.make_cov(branch=branch, timestamps=False)
+        self.run_prog(cov, "prog")
+        report = self.json_report(cov)
+        entries = self.all_entries(report)
+        assert len(entries) > 3
+        for entry in entries:
+            assert "line_timestamps" not in entry
+            assert "branch_timestamps" not in entry
+        work_data = report["files"]["work.py"]
+        assert work_data["executed_lines"] == [1, 2, 3, 4, 6, 7, 9, 10]
+        if branch:
+            assert sorted(work_data["executed_branches"]) == [[3, 4], [3, 6]]
+
+    def test_line_offsets(self) -> None:
+        self.make_file("prog.py", PROG_PY)
+        cov = self.make_cov()
+        before, _ = self.run_prog(cov, "prog")
+        data = cov.get_data()
+        report = self.json_report(cov)
+
+        starts = []
+        for filename, file_data in report["files"].items():
+            offsets = self.file_line_offsets(file_data)
+            assert set(offsets) == set(file_data["executed_lines"])
+            times = data.line_timestamps(abs_file(filename))
+            assert times is not None
+            starts.append(self.assert_offsets(offsets, times))
+            assert "branch_timestamps" not in file_data
+        assert set(report["files"]) == {"clock.py", "prog.py", "work.py"}
+
+        # Every file is measured from the same start, before anything ran.
+        first_time = min(
+            min((data.line_timestamps(f) or {}).values()) for f in data.measured_files()
+        )
+        for start in starts:
+            assert start == pytest.approx(starts[0], abs=TOLERANCE)
+            assert before - TOLERANCE <= start <= first_time + TOLERANCE
+
+        mark = self.prog_attr("mark")
+        work_offsets = self.file_line_offsets(report["files"]["work.py"])
+        assert work_offsets[4] <= mark - starts[0] + TOLERANCE
+        assert work_offsets[6] > mark - starts[0] - TOLERANCE
+        assert work_offsets[4] < work_offsets[6]
