+                arc_times = combined.arc_timestamps(wf)
+                assert arc_times == earliest(arcs_a, arcs_b)
+                assert arc_times is not None and arcs_a is not None and arcs_b is not None
+                assert arc_times[3, 4] == arcs_a[3, 4]
+                assert arc_times[3, 6] == arcs_b[3, 6]
+
+        # The combined data is saved and can be read back.
+        reread = CoverageData("ba")
+        reread.read()
+        assert reread.line_timestamps(wf) == earliest(lines_a, lines_b)
