+        branch_offsets = self.file_branch_offsets(work_data)
+        assert set(branch_offsets) == {tuple(b) for b in work_data["executed_branches"]}
+        assert set(branch_offsets) == {(3, 4), (3, 6)}
+
+        start = self.assert_offsets(line_offsets, line_times)
+        assert self.assert_offsets(branch_offsets, arc_times) == pytest.approx(start, abs=TOLERANCE)
+        assert before - TOLERANCE <= start <= min(line_times.values()) + TOLERANCE
+        assert branch_offsets[3, 4] < branch_offsets[3, 6]
