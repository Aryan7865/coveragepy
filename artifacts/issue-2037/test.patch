+# Licensed under the Apache License: http://www.apache.org/licenses/LICENSE-2.0
+# For details: https://github.com/coveragepy/coveragepy/blob/main/NOTICE.txt
+
+"""Tests for recording when lines and arcs were first executed."""
+
+from __future__ import annotations
+
+import json
+import sys
+import time
+from types import ModuleType
+from typing import Any
+
+import pytest
+
+import coverage
+from coverage import Coverage, CoverageData, env
+from coverage.core import CTRACER_FILE
+from coverage.files import abs_file
+from coverage.misc import import_local_file
+from coverage.types import TArc, TLineNo
+
+from tests.coveragetest import CoverageTest
+
+# A helper module for the measured programs.  tick() returns a time that is
+# later than everything that happened before the call, and earlier than
+# everything that happens after it.
+CLOCK_PY = """\
+import time
+
+def tick():
+    now = later = time.time()
+    while later <= now:
+        later = time.time()
+    return now
+"""
+
+# The measured code.  Line numbers matter to the tests:
+#   3: the `if`, 4: the true branch, 6: the false branch, 7: the return.
+WORK_PY = """\
+def work(x):
+    total = 0
+    if x:
+        total += 1
+    else:
+        total += 2
+    return total
+
+class Thing:
+    def method(self):
+        return work(True)
+"""
+
+# A program that runs the true branch, ticks, then runs both branches.
+PROG_PY = """\
+import clock
+import work
+
+work.work(True)
+mark = clock.tick()
+work.work(True)
+work.work(False)
+"""
+
+# A program that only runs the true branch.
+TRUE_ONLY_PY = """\
+import work
+
+work.work(True)
+"""
+
+# A program that runs both branches.
+BOTH_PY = """\
+import work
+
+work.work(True)
+work.work(False)
+"""
+
+
+def core_params() -> list[Any]:
+    """The measurement cores usable here, each with and without branch coverage."""
+    cores = [("pytrace", "PyTracer", True)]
+    if CTRACER_FILE:
+        cores.append(("ctrace", "CTracer", True))
+    if env.PYBEHAVIOR.pep669:
+        cores.append(("sysmon", "SysMonitor", env.PYBEHAVIOR.branch_right_left))
+    params = []
+    for core, tracer_name, can_branch in cores:
+        for branch in [False, True] if can_branch else [False]:
+            params.append(
+                pytest.param(
+                    core, tracer_name, branch, id=f"{core}-{'branch' if branch else 'line'}"
+                )
+            )
+    return params
+
+
+# A tolerance for comparing times that have been through float arithmetic on
+# epoch-sized numbers.
+TOLERANCE = 1e-4
+
+
+class TimestampTestBase(CoverageTest):
+    """Helpers for timestamp tests."""
+
+    def setUp(self) -> None:
+        super().setUp()
+        self.make_file("clock.py", CLOCK_PY)
+        self.make_file("work.py", WORK_PY)
+        # The module most recently run by run_prog.
+        self.prog: ModuleType | None = None
+
+    def make_cov(self, branch: bool = False, timestamps: bool = True, **kwargs: Any) -> Coverage:
+        """Make a Coverage object, with timestamps enabled unless told otherwise."""
+        cov = coverage.Coverage(branch=branch, **kwargs)
+        cov.set_option("run:timestamps", timestamps)
+        return cov
+
+    def run_prog(
+        self, cov: Coverage, modname: str, modfile: str | None = None
+    ) -> tuple[float, float]:
+        """Run a module under `cov`, returning times from before and after the run."""
+        # Measured modules are imported fresh for each run.
+        for name in ["clock", "work", "other"]:
+            sys.modules.pop(name, None)
+        before = time.time()
+        self.prog = self.start_import_stop(cov, modname, modfile)
+        after = time.time()
+        return before, after
+
+    def prog_attr(self, name: str) -> Any:
+        """Get an attribute of the module most recently run by run_prog."""
+        assert self.prog is not None
+        return getattr(self.prog, name)
+
+    def run_to_data_file(
+        self,
+        text: str,
+        suffix: str,
+        branch: bool = False,
+        timestamps: bool = True,
+        **kwargs: Any,
+    ) -> tuple[CoverageData, float, float]:
+        """Run `text` as a program, saving its data to a suffixed data file.
+
+        Returns the data read back from the file, and the times before and
+        after the run.
+
+        """
+        modname = f"prog_{suffix}"
+        self.make_file(f"{modname}.py", text)
+        cov = self.make_cov(branch=branch, timestamps=timestamps, data_suffix=suffix, **kwargs)
+        before, after = self.run_prog(cov, modname)
+        cov.save()
+        data = CoverageData(f".coverage.{suffix}")
+        data.read()
+        return data, before, after
+
+    def work_file(self) -> str:
+        """The measured file name of work.py."""
+        return abs_file("work.py")
+
+
+def assert_times_between(times: dict[Any, float], before: float, after: float) -> None:
+    """Check that every time in `times` is in [before, after]."""
+    assert times
+    for key, when in times.items():
+        assert before <= when <= after, f"{key!r}: {when} not in [{before}, {after}]"
+
+
+def earliest(*timeses: dict[Any, float] | None) -> dict[Any, float]:
+    """Combine dicts of times, keeping the earliest time for each key."""
+    result: dict[Any, float] = {}
+    for times in timeses:
+        for key, when in (times or {}).items():
+            result[key] = min(when, result.get(key, when))
+    return result
+
+
+class TimestampConfigTest(TimestampTestBase):
+    """Tests of turning timestamps on and off."""
+
+    def test_off_by_default(self) -> None:
+        cov = coverage.Coverage()
+        assert cov.config.timestamps is False
+        assert cov.config.get_option("run:timestamps") is False
+
+    def test_config_file_setting(self) -> None:
+        self.make_file(
+            ".coveragerc",
+            """\
+            [run]
+            timestamps = True
+            """,
+        )
+        self.make_file("prog.py", BOTH_PY)
+        cov = coverage.Coverage()
+        assert cov.config.get_option("run:timestamps") is True
+        before, after = self.run_prog(cov, "prog")
+        times = cov.get_data().line_timestamps(self.work_file())
+        assert times is not None
+        assert_times_between(times, before, after)
+
+    def test_toml_config_setting(self) -> None:
+        self.make_file(
+            "pyproject.toml",
+            """\
+            [tool.coverage.run]
+            timestamps = true
+            branch = true
+            """,
+        )
+        self.make_file("prog.py", BOTH_PY)
+        cov = coverage.Coverage()
+        before, after = self.run_prog(cov, "prog")
+        times = cov.get_data().arc_timestamps(self.work_file())
+        assert times is not None
+        assert_times_between(times, before, after)
+
+    @pytest.mark.parametrize("branch", [False, True])
+    def test_disabled_records_no_timestamps(self, branch: bool) -> None:
+        self.make_file("prog.py", BOTH_PY)
+        cov = self.make_cov(branch=branch, timestamps=False)
+        self.run_prog(cov, "prog")
+        data = cov.get_data()
+        assert sorted(data.lines(self.work_file()) or []) == [1, 2, 3, 4, 6, 7, 9, 10]
+        assert data.line_timestamps(self.work_file()) == {}
+        assert data.arc_timestamps(self.work_file()) == {}
+
+    @pytest.mark.parametrize("branch", [False, True])
+    def test_timestamps_dont_change_measurement(self, branch: bool) -> None:
+        self.make_file("prog.py", PROG_PY)
+        cov_off = self.make_cov(branch=branch, timestamps=False, data_file=".cov_off")
+        self.run_prog(cov_off, "prog")
+        cov_on = self.make_cov(branch=branch, timestamps=True, data_file=".cov_on")
+        self.run_prog(cov_on, "prog")
+        data_off = cov_off.get_data()
+        data_on = cov_on.get_data()
+        assert data_on.has_arcs() == data_off.has_arcs() == branch
+        assert data_on.measured_files() == data_off.measured_files()
+        for filename in data_on.measured_files():
+            assert sorted(data_on.lines(filename) or []) == sorted(data_off.lines(filename) or [])
+            assert sorted(data_on.arcs(filename) or []) == sorted(data_off.arcs(filename) or [])
+
+    def test_unmeasured_file(self) -> None:
+        data = CoverageData(no_disk=True)
+        assert data.line_timestamps("nope.py") is None
+        assert data.arc_timestamps("nope.py") is None
+
+        self.make_file("prog.py", BOTH_PY)
+        cov = self.make_cov(branch=True)
+        self.run_prog(cov, "prog")
+        data = cov.get_data()
+        assert data.line_timestamps(abs_file("nope.py")) is None
+        assert data.arc_timestamps(abs_file("nope.py")) is None
+
+
+class LineTimestampTest(TimestampTestBase):
+    """Tests of timestamps for line coverage."""
+
+    def test_every_executed_line_has_a_time(self) -> None:
+        self.make_file("prog.py", TRUE_ONLY_PY)
+        cov = self.make_cov()
+        before, after = self.run_prog(cov, "prog")
+        data = cov.get_data()
+        times = data.line_timestamps(self.work_file())
+        assert times is not None
+        assert set(times) == set(data.lines(self.work_file()) or []) == {1, 2, 3, 4, 7, 9, 10}
+        assert_times_between(times, before, after)
+
+        prog_times = data.line_timestamps(abs_file("prog.py"))
+        assert prog_times is not None
+        assert set(prog_times) == {1, 3}
+        assert_times_between(prog_times, before, after)
+
+    def test_first_execution_is_kept(self) -> None:
+        self.make_file("prog.py", PROG_PY)
+        cov = self.make_cov()
+        before, after = self.run_prog(cov, "prog")
+        mark = self.prog_attr("mark")
+        times = cov.get_data().line_timestamps(self.work_file())
+        assert times is not None
+        # Executed before the mark, and again after it.
+        for lineno in [2, 3, 4, 7]:
+            assert before <= times[lineno] <= mark
+        # Only executed after the mark.
+        assert mark < times[6] <= after
+
+    def test_order_of_first_execution(self) -> None:
+        self.make_file(
+            "prog.py",
+            """\
+            import clock
+            import work
+
+            work.work(False)
+            mark1 = clock.tick()
+            work.work(True)
+            mark2 = clock.tick()
+            work.Thing().method()
+            """,
+        )
+        cov = self.make_cov()
+        before, after = self.run_prog(cov, "prog")
+        mark1 = self.prog_attr("mark1")
+        mark2 = self.prog_attr("mark2")
+        times = cov.get_data().line_timestamps(self.work_file())
+        assert times is not None
+        assert before <= times[6] <= mark1 < times[4] <= mark2 < times[11] <= after
+        prog_times = cov.get_data().line_timestamps(abs_file("prog.py"))
+        assert prog_times is not None
+        assert prog_times[4] <= mark1 < prog_times[6] <= mark2 < prog_times[8] <= after
+
+    def test_single_executed_line(self) -> None:
+        self.make_file("one.py", "x = 1\n")
+        cov = self.make_cov()
+        before, after = self.run_prog(cov, "one")
+        times = cov.get_data().line_timestamps(abs_file("one.py"))
+        assert times is not None
+        assert list(times) == [1]
+        assert_times_between(times, before, after)
+
+    def test_unexecuted_file(self) -> None:
+        self.make_file("never.py", "a = 1\nb = 2\n")
+        self.make_file("prog.py", TRUE_ONLY_PY)
+        cov = self.make_cov(source=["."])
+        self.run_prog(cov, "prog")
+        data = cov.get_data()
+        assert data.lines(abs_file("never.py")) == []
+        assert data.line_timestamps(abs_file("never.py")) == {}
+
+    def test_multiple_files(self) -> None:
+        self.make_file("other.py", "def hello():\n    return 'hi'\n")
+        self.make_file(
+            "prog.py",
+            """\
+            import clock
+            import work
+            work.work(True)
+            mark = clock.tick()
+            import other
+            other.hello()
+            """,
+        )
+        cov = self.make_cov()
+        before, after = self.run_prog(cov, "prog")
+        mark = self.prog_attr("mark")
+        data = cov.get_data()
+        work_times = data.line_timestamps(self.work_file())
+        other_times = data.line_timestamps(abs_file("other.py"))
+        assert work_times is not None and other_times is not None
+        assert set(work_times) == {1, 2, 3, 4, 7, 9, 10}
+        assert set(other_times) == {1, 2}
+        assert_times_between(work_times, before, mark)
+        assert_times_between(other_times, mark, after)
+
