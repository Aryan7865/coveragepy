+        assert beta_times is not None
+        assert set(offsets) == set(beta_times)
+        start = self.assert_offsets(offsets, beta_times)
+
+        full = self.json_report(cov)
+        full_offsets = self.file_line_offsets(full["files"]["work.py"])
+        assert self.assert_offsets(full_offsets, all_times) == pytest.approx(start, abs=TOLERANCE)
+        # The alpha run was first, so the full report shows earlier times.
+        assert full_offsets[4] < offsets[4]
