+    def line_timestamps(self, filename: str) -> dict[TLineNo, float] | None:
+        """Get the times lines in a file were first executed.
+
+        If the file was not measured, returns None.  Otherwise returns a dict
+        mapping line numbers to the time each line was first executed, in
+        seconds since the epoch.  Lines executed without recording timestamps
+        aren't included.
+
+        .. versionadded:: 7.16
+
+        """
+        self._start_using()
+        if self.has_arcs():
+            arc_times = self.arc_timestamps(filename)
+            if arc_times is not None:
+                line_times: dict[TLineNo, float] = {}
+                for arc, when in arc_times.items():
+                    for lineno in arc:
+                        if lineno > 0:
+                            line_times[lineno] = min(when, line_times.get(lineno, when))
+                return line_times
+
+        with self._connect() as con:
+            file_id = self._file_id(filename)
+            if file_id is None:
+                return None
+            else:
+                query = "SELECT lineno, min(first_time) FROM line_time WHERE file_id = ?"
+                data = [file_id]
+                if self._query_context_ids is not None:
+                    ids_array = ", ".join("?" * len(self._query_context_ids))
+                    query += " AND context_id IN (" + ids_array + ")"
+                    data += self._query_context_ids
+                query += " GROUP BY lineno"
+                with con.execute(query, data) as cur:
