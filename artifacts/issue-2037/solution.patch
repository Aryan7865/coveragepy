+    def first_times(
+        self, coverage_data: CoverageData, analysis: Analysis, file_reporter: FileReporter
+    ) -> tuple[dict[TLineNo, float], dict[TArc, float]]:
+        """Get the first execution times of a file's lines and arcs.
+
+        The line numbers and arcs are translated the same way the analysis
+        translates them.
+
+        """
+        line_times: dict[TLineNo, float] = {}
+        arc_times: dict[TArc, float] = {}
+        if self.start_time is None:
+            return line_times, arc_times
+
+        for lineno, when in (coverage_data.line_timestamps(analysis.filename) or {}).items():
+            for translated in file_reporter.translate_lines([lineno]):
+                line_times[translated] = min(when, line_times.get(translated, when))
+        if coverage_data.has_arcs():
+            for arc, when in (coverage_data.arc_timestamps(analysis.filename) or {}).items():
+                for translated_arc in file_reporter.translate_arcs([arc]):
