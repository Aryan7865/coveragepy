+/* Record an item in self->pcur_entry->file_data. */
+static int
+CTracer_record_item(CTracer *self, PyObject * item)
+{
+    int ret = RET_ERROR;
+    PyObject * file_data = self->pcur_entry->file_data;
+    PyObject * now = NULL;
+    int seen;
+
+    if (PyDict_Check(file_data)) {
+        /* Recording timestamps: keep the time the item was first seen. */
+        seen = PyDict_Contains(file_data, item);
+        if (seen < 0) {
+            goto error;
+        }
+        if (!seen) {
+            now = PyObject_CallNoArgs(self->timer);
+            if (now == NULL) {
+                goto error;
+            }
+            if (PyDict_SetItem(file_data, item, now) < 0) {
+                goto error;
+            }
+        }
+    }
+    else if (PySet_Add(file_data, item) < 0) {
+        goto error;
+    }
+
+    ret = RET_OK;
+
+error:
+    Py_XDECREF(now);
+
+    return ret;
+}
