+        first executed, in seconds since the epoch.  Arcs executed without
+        recording timestamps aren't included.
+
+        .. versionadded:: 7.16
+
+        """
+        self._start_using()
+        with self._connect() as con:
+            file_id = self._file_id(filename)
+            if file_id is None:
+                return None
+            else:
+                query = """
+                    SELECT fromno, tono, min(first_time) FROM arc
+                    WHERE file_id = ? AND first_time IS NOT NULL
+                """
+                data = [file_id]
+                if self._query_context_ids is not None:
+                    ids_array = ", ".join("?" * len(self._query_context_ids))
+                    query += " AND context_id IN (" + ids_array + ")"
+                    data += self._query_context_ids
+                query += " GROUP BY fromno, tono"
