+                for lineno in sorted(analysis.executed)
+                if lineno in line_times
+            },
+        }
+        if analysis.has_arcs:
+            timestamp_data["branch_timestamps"] = [
+                [fromno, tono, arc_times[fromno, tono] - self.start_time]
+                for fromno, tono in _convert_branch_arcs(analysis.executed_branch_arcs())
+                if (fromno, tono) in arc_times
+            ]
+        return timestamp_data
+
 
