+def unpack_arc(packed: int) -> TArc:
+    """Unpack an arc packed into an integer by the C tracer."""
+    l1 = packed & 0xFFFFFFF
+    l2 = (packed & (0xFFFFFFF << 28)) >> 28
+    if packed & (1 << 56):
+        l1 *= -1
+    if packed & (1 << 57):
+        l2 *= -1
+    return l1, l2
